# No environment variables are required. The county dog feed is a public URL.

# --- Supabase (foster-portal, project twsomyzkoggtuefecpew) ---
# Safe to ship to the browser. Every table is behind RLS.
NEXT_PUBLIC_SUPABASE_URL=https://twsomyzkoggtuefecpew.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# BYPASSES ALL RLS. Server only. Used by the deadline-alert cron and nothing else.
# Never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Which org this deployment serves. 'tcdp' here, 'soshub' on the sister deploy.
NEXT_PUBLIC_ORG_SLUG=tcdp

# --- Resend ---
# Applicant confirmations, approve/deny notes, deadline alerts.
RESEND_API_KEY=
RESEND_FROM="The CrAZy Dog People <hello@thecrazydogpeople.com>"

# Shared secret for the deadline-alert cron endpoint, so only Vercel Cron can fire it.
CRON_SECRET=
